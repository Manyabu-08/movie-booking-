rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check document for connection verification
    match /test/connection {
      allow get: if true;
    }

    // --- Global Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'bumanya90@gmail.com'
      );
    }

    function isValidGenreList(listVal, maxLen) {
      return listVal is list && listVal.size() <= maxLen && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidCategory(cat) {
      return cat in [
        'Horror', 'Family', 'Comedy', 'Action', 'Romance', 'Thriller',
        'Science Fiction', 'Animation', 'Adventure', 'Drama', 'Mystery', 'Fantasy'
      ];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'city', 'favoriteGenres', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'city', 'favoriteGenres', 'role', 'photoUrl', 'aiPersonalizationConsent', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        isValidGenreList(data.favoriteGenres, 12) &&
        data.role == 'user' &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('aiPersonalizationConsent' in data) || data.aiPersonalizationConsent is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.grantedAt is timestamp;
    }

    function isValidMovie(data) {
      return data.keys().hasAll([
          'id', 'title', 'synopsis', 'posterUrl', 'language', 'durationMinutes',
          'rating', 'officialCertification', 'releaseDate', 'status', 'trending',
          'featured', 'cities', 'cast', 'primaryCategory', 'secondaryCategories',
          'moodTags', 'aiExplanation', 'aiFamilyFriendlyAssessment',
          'aiFamilyFriendlyNote', 'aiReviewedByAdmin', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'synopsis', 'posterUrl', 'bannerUrl', 'trailerUrl',
          'language', 'durationMinutes', 'rating', 'officialCertification',
          'releaseDate', 'status', 'trending', 'featured', 'cities', 'cast',
          'primaryCategory', 'secondaryCategories', 'moodTags', 'aiExplanation',
          'aiFamilyFriendlyAssessment', 'aiFamilyFriendlyNote', 'aiReviewedByAdmin',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 2000 &&
        data.posterUrl is string && data.posterUrl.size() >= 1 && data.posterUrl.size() <= 500 &&
        (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 500)) &&
        (!('trailerUrl' in data) || (data.trailerUrl is string && data.trailerUrl.size() <= 500)) &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 60 &&
        data.durationMinutes is number && data.durationMinutes >= 20 && data.durationMinutes <= 450 &&
        data.rating is number && data.rating >= 0 && data.rating <= 10 &&
        data.officialCertification is string && data.officialCertification.size() >= 1 && data.officialCertification.size() <= 20 &&
        data.releaseDate is string && data.releaseDate.size() == 10 && data.releaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.status in ['now_showing', 'coming_soon'] &&
        data.trending is bool &&
        data.featured is bool &&
        data.cities is list && data.cities.size() >= 1 && data.cities.size() <= 20 && data.cities[0] is string &&
        data.cast is list && data.cast.size() <= 20 && (data.cast.size() == 0 || data.cast[0] is string) &&
        isValidCategory(data.primaryCategory) &&
        isValidGenreList(data.secondaryCategories, 5) &&
        isValidGenreList(data.moodTags, 8) &&
        data.aiExplanation is string && data.aiExplanation.size() <= 600 &&
        data.aiFamilyFriendlyAssessment in ['likely_family_friendly', 'caution_advised', 'adult_themes', 'uncertain'] &&
        data.aiFamilyFriendlyNote is string && data.aiFamilyFriendlyNote.size() <= 300 &&
        data.aiReviewedByAdmin is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTheatre(data) {
      return data.keys().hasAll(['id', 'name', 'city', 'address', 'screens', 'amenities', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'city', 'address', 'screens', 'amenities', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 240 &&
        data.screens is number && data.screens >= 1 && data.screens <= 40 &&
        data.amenities is list && data.amenities.size() <= 12 && (data.amenities.size() == 0 || data.amenities[0] is string) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShowtime(data) {
      return data.keys().hasAll([
          'id', 'movieId', 'theatreId', 'city', 'screenName', 'showDate',
          'showTime', 'format', 'standardPrice', 'premiumPrice',
          'convenienceFeePerTicket', 'bookedSeats', 'heldSeats', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'movieId', 'theatreId', 'city', 'screenName', 'showDate',
          'showTime', 'format', 'standardPrice', 'premiumPrice',
          'convenienceFeePerTicket', 'bookedSeats', 'heldSeats', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.movieId) &&
        isValidId(data.theatreId) &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.screenName is string && data.screenName.size() >= 1 && data.screenName.size() <= 60 &&
        data.showDate is string && data.showDate.size() == 10 && data.showDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.showTime is string && data.showTime.size() >= 1 && data.showTime.size() <= 20 &&
        data.format is string && data.format.size() >= 1 && data.format.size() <= 30 &&
        data.standardPrice is number && data.standardPrice >= 50 && data.standardPrice <= 5000 &&
        data.premiumPrice is number && data.premiumPrice >= 50 && data.premiumPrice <= 10000 &&
        data.convenienceFeePerTicket is number && data.convenienceFeePerTicket >= 0 && data.convenienceFeePerTicket <= 500 &&
        data.bookedSeats is list && data.bookedSeats.size() <= 100 && (data.bookedSeats.size() == 0 || data.bookedSeats[0] is string) &&
        data.heldSeats is map && data.heldSeats.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSeatReservation(data) {
      return data.keys().hasAll([
          'id', 'userId', 'showtimeId', 'movieId', 'theatreId', 'seats',
          'status', 'ticketAmount', 'convenienceFee', 'totalAmount',
          'expiresAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'showtimeId', 'movieId', 'theatreId', 'seats',
          'status', 'ticketAmount', 'convenienceFee', 'totalAmount',
          'expiresAtMs', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.showtimeId) &&
        isValidId(data.movieId) &&
        isValidId(data.theatreId) &&
        data.seats is list && data.seats.size() >= 1 && data.seats.size() <= 10 && data.seats[0] is string &&
        data.status in ['pending_payment', 'confirmed', 'cancelled', 'expired'] &&
        data.ticketAmount is number && data.ticketAmount > 0 && data.ticketAmount <= 100000 &&
        data.convenienceFee is number && data.convenienceFee >= 0 && data.convenienceFee <= 10000 &&
        data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 110000 &&
        data.expiresAtMs is number && data.expiresAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'id', 'bookingCode', 'userId', 'userEmail', 'userName', 'movieId',
          'movieTitle', 'posterUrl', 'theatreId', 'theatreName', 'city',
          'showtimeId', 'screenName', 'showDate', 'showTime', 'format',
          'seats', 'ticketAmount', 'convenienceFee', 'totalAmount', 'paymentId',
          'paymentStatus', 'bookingStatus', 'reservationId', 'qrReference',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingCode', 'userId', 'userEmail', 'userName', 'movieId',
          'movieTitle', 'posterUrl', 'theatreId', 'theatreName', 'city',
          'showtimeId', 'screenName', 'showDate', 'showTime', 'format',
          'seats', 'ticketAmount', 'convenienceFee', 'totalAmount', 'paymentId',
          'paymentStatus', 'bookingStatus', 'reservationId', 'qrReference',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.bookingCode is string && data.bookingCode.size() >= 6 && data.bookingCode.size() <= 40 && data.bookingCode.matches('^[A-Z0-9\\-]+$') &&
        isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        isValidId(data.movieId) &&
        data.movieTitle is string && data.movieTitle.size() >= 1 && data.movieTitle.size() <= 160 &&
        data.posterUrl is string && data.posterUrl.size() >= 1 && data.posterUrl.size() <= 500 &&
        isValidId(data.theatreId) &&
        data.theatreName is string && data.theatreName.size() >= 1 && data.theatreName.size() <= 140 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        isValidId(data.showtimeId) &&
        data.screenName is string && data.screenName.size() >= 1 && data.screenName.size() <= 60 &&
        data.showDate is string && data.showDate.size() == 10 && data.showDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.showTime is string && data.showTime.size() >= 1 && data.showTime.size() <= 20 &&
        data.format is string && data.format.size() >= 1 && data.format.size() <= 30 &&
        data.seats is list && data.seats.size() >= 1 && data.seats.size() <= 10 && data.seats[0] is string &&
        data.ticketAmount is number && data.ticketAmount > 0 && data.ticketAmount <= 100000 &&
        data.convenienceFee is number && data.convenienceFee >= 0 && data.convenienceFee <= 10000 &&
        data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 110000 &&
        data.paymentId is string && data.paymentId.size() >= 4 && data.paymentId.size() <= 80 &&
        data.paymentStatus in ['paid', 'failed'] &&
        data.bookingStatus in ['confirmed', 'cancelled'] &&
        isValidId(data.reservationId) &&
        data.qrReference is string && data.qrReference.size() >= 6 && data.qrReference.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users (Strict PII Isolation & Self-Escalation Guard)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'user' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'city', 'favoriteGenres', 'photoUrl', 'aiPersonalizationConsent', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Admins (Strictly Admin-Controlled)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // 3. Movies (Public Read, Admin-Only Write)
    match /movies/{movieId} {
      allow get: if isValidId(movieId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(movieId) &&
        isValidMovie(incoming()) &&
        incoming().id == movieId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(movieId) &&
        isValidMovie(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(movieId) && isAdmin();
    }

    // 4. Theatres (Public Read, Admin-Only Write)
    match /theatres/{theatreId} {
      allow get: if isValidId(theatreId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(theatreId) &&
        isValidTheatre(incoming()) &&
        incoming().id == theatreId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(theatreId) &&
        isValidTheatre(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(theatreId) && isAdmin();
    }

    // 5. Showtimes (Public Read, Admin Manage + Atomic User Seat Locks/Confirm)
    match /showtimes/{showtimeId} {
      allow get: if isValidId(showtimeId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(showtimeId) &&
        isValidShowtime(incoming()) &&
        incoming().id == showtimeId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/movies/$(incoming().movieId)) &&
        exists(/databases/$(database)/documents/theatres/$(incoming().theatreId));
      allow update: if isValidId(showtimeId) &&
        isValidShowtime(incoming()) &&
        incoming().id == existing().id &&
        incoming().movieId == existing().movieId &&
        incoming().theatreId == existing().theatreId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isEmailVerified() && (
            // Action: Hold or release temporary seats
            (incoming().diff(existing()).affectedKeys().hasOnly(['heldSeats', 'updatedAt'])) ||
            // Action: Confirm booked seats atomically (append-only, never removes existing booked seats)
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['bookedSeats', 'heldSeats', 'updatedAt']) &&
              incoming().bookedSeats.hasAll(existing().bookedSeats) &&
              incoming().bookedSeats.size() > existing().bookedSeats.size()
            )
          ))
        );
      allow delete: if isValidId(showtimeId) && isAdmin();
    }

    // 6. Seat Reservations (Owner-Scoped, Terminal State Locked)
    match /seatReservations/{reservationId} {
      allow get: if isValidId(reservationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() &&
        isValidId(reservationId) &&
        isValidSeatReservation(incoming()) &&
        incoming().id == reservationId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending_payment' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/showtimes/$(incoming().showtimeId)) &&
        exists(/databases/$(database)/documents/movies/$(incoming().movieId)) &&
        exists(/databases/$(database)/documents/theatres/$(incoming().theatreId));
      allow update: if isEmailVerified() &&
        isValidId(reservationId) &&
        isValidSeatReservation(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().showtimeId == existing().showtimeId &&
        incoming().movieId == existing().movieId &&
        incoming().theatreId == existing().theatreId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'pending_payment' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            incoming().status in ['confirmed', 'cancelled', 'expired']
          )
        );
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    // 7. Bookings (Owner-Scoped, Atomic Seat-Lock Verification via getAfter)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == bookingId &&
        incoming().userId == request.auth.uid &&
        incoming().paymentStatus == 'paid' &&
        incoming().bookingStatus == 'confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/showtimes/$(incoming().showtimeId)) &&
        exists(/databases/$(database)/documents/seatReservations/$(incoming().reservationId)) &&
        getAfter(/databases/$(database)/documents/showtimes/$(incoming().showtimeId)).data.bookedSeats.hasAll(incoming().seats);
      allow update: if isEmailVerified() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().showtimeId == existing().showtimeId &&
        incoming().reservationId == existing().reservationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().bookingStatus == 'confirmed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['bookingStatus', 'updatedAt']) &&
            incoming().bookingStatus == 'cancelled'
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }
  }
}
