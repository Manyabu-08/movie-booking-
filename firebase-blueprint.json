        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "movieId",
        "theatreId",
        "city",
        "screenName",
        "showDate",
        "showTime",
        "format",
        "standardPrice",
        "premiumPrice",
        "convenienceFeePerTicket",
        "bookedSeats",
        "heldSeats",
        "createdAt",
        "updatedAt"
