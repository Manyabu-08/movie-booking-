  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and genre preferences isolated per owner."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role registry controlled strictly by existing admins."
    },
    "/movies/{movieId}": {
      "schema": { "$ref": "#/entities/Movie" },
      "description": "Public movie catalog with Gemini AI categorization metadata."
    },
    "/theatres/{theatreId}": {
      "schema": { "$ref": "#/entities/Theatre" },
      "description": "Public multiplex theatre listings by city."
    },
    "/showtimes/{showtimeId}": {
      "schema": { "$ref": "#/entities/Showtime" },
      "description": "Showtime schedules and atomic seat availability."
    },
    "/seatReservations/{reservationId}": {
      "schema": { "$ref": "#/entities/SeatReservation" },
      "description": "User-owned temporary seat reservations prior to payment."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "User-owned confirmed cinema ticket bookings."
    }
  }
}
