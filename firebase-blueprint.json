{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated CineBook AI user profile and genre preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "favoriteGenres": {
          "type": "array",
          "description": "Up to 12 favorite cinema genres."
        },
        "role": {
          "type": "string",
          "enum": ["user"]
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "aiPersonalizationConsent": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "city", "favoriteGenres", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator access record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Cinema movie listing with Gemini AI categorization metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "synopsis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "posterUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "bannerUrl": {
          "type": "string",
          "maxLength": 500
        },
        "trailerUrl": {
          "type": "string",
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "durationMinutes": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "officialCertification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["now_showing", "coming_soon"]
        },
        "trending": {
          "type": "boolean"
        },
        "featured": {
          "type": "boolean"
        },
        "cities": {
          "type": "array"
        },
        "cast": {
          "type": "array"
        },
        "primaryCategory": {
          "type": "string",
          "enum": [
            "Horror",
            "Family",
            "Comedy",
            "Action",
            "Romance",
            "Thriller",
            "Science Fiction",
            "Animation",
            "Adventure",
            "Drama",
            "Mystery",
            "Fantasy"
          ]
        },
        "secondaryCategories": {
          "type": "array"
        },
        "moodTags": {
          "type": "array"
        },
        "aiExplanation": {
          "type": "string",
          "maxLength": 600
        },
        "aiFamilyFriendlyAssessment": {
          "type": "string",
          "enum": ["likely_family_friendly", "caution_advised", "adult_themes", "uncertain"]
        },
        "aiFamilyFriendlyNote": {
          "type": "string",
          "maxLength": 300
        },
        "aiReviewedByAdmin": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "synopsis",
        "posterUrl",
        "language",
        "durationMinutes",
        "rating",
        "officialCertification",
        "releaseDate",
        "status",
        "trending",
        "featured",
        "cities",
        "cast",
        "primaryCategory",
        "secondaryCategories",
        "moodTags",
        "aiExplanation",
        "aiFamilyFriendlyAssessment",
        "aiFamilyFriendlyNote",
        "aiReviewedByAdmin",
        "createdAt",
        "updatedAt"
      ]
    },
    "Theatre": {
      "title": "Theatre",
      "description": "Cinema multiplex theatre venue.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "screens": {
          "type": "number"
        },
        "amenities": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "city", "address", "screens", "amenities", "createdAt", "updatedAt"]
    },
    "Showtime": {
      "title": "Showtime",
      "description": "Database-driven movie screening slot with seat occupancy.",
