        "screenName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "showDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "showTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "format": {
          "type": "string",
          "minLength": 1,
